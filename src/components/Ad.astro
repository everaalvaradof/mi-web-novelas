---

<!-- Este script carga solo en PC -->
<div class="ad-pc">
    <script is:inline>
        window.atOptions = {
            'key' : '0af4c72cda443968a1bd54dee666ca9c',
            'format' : 'iframe',
            'height' : 90,
            'width' : 728,
            'params' : {}
        };
    </script>
    <script is:inline src="https://www.highperformanceformat.com/0af4c72cda443968a1bd54dee666ca9c/invoke.js"></script>
</div>

<!-- Este script carga solo en Móvil -->
<div class="ad-mobile">
    <script is:inline>
        window.atOptions = {
            'key' : 'e9d462920b4e0e304ffcd31c227085cd',
            'format' : 'iframe',
            'height' : 250,
            'width' : 300,
            'params' : {}
        };
    </script>
    <script is:inline src="https://www.highperformanceformat.com/e9d462920b4e0e304ffcd31c227085cd/invoke.js"></script>
</div>

<style>
    /* Estilo básico para centrar */
    .ad-pc, .ad-mobile { 
        display: flex; 
        justify-content: center; 
        margin: 20px 0; 
        min-height: 90px; /* Evita que el layout salte */
    }

    /* Lógica: Esconder/Mostrar según el tamaño */
    @media (max-width: 768px) {
        .ad-pc { display: none !important; }
        .ad-mobile { display: flex !important; }
    }

    @media (min-width: 769px) {
        .ad-pc { display: flex !important; }
        .ad-mobile { display: none !important; }
    }
</style>

