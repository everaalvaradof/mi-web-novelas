---
import { novelas } from '../data/novelas.js'; 
import SEO from '../components/SEO.astro';

// Recibimos las propiedades de SEO y layout desde las páginas
const { 
    noSidebar, 
    title = "Novelas Ligeras - Tu portal de lectura", 
    description = "Lee las mejores novelas web y ligeras actualizadas en español.", 
    image = "/logo.png" 
} = Astro.props;

// 1. Contar géneros
const conteoGeneros = {};
novelas.forEach(n => {
    if (n.genero) {
        n.genero.split(',').forEach(g => {
            const generoLimpio = g.trim();
            conteoGeneros[generoLimpio] = (conteoGeneros[generoLimpio] || 0) + 1;
        });
    }
});

// 2. Contar categorías
const conteoCategoria = {};
novelas.forEach(n => {
    if (n.categoria) {
        const cat = n.categoria.trim();
        conteoCategoria[cat] = (conteoCategoria[cat] || 0) + 1;
    }
});
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Aquí integramos nuestro componente SEO dinámico -->
    <SEO title={title} description={description} image={image} />

    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <header class="main-header">
        <button class="menu-toggle">☰</button>

        <nav class="mobile-menu">
            <button class="close-menu">✕</button>
            <ul>
                <li><a href="/">Inicio</a></li>
                <li><a href="/pais/chinas/1">Chinas</a></li>
            </ul>
            <h3>Géneros</h3>
            <ul>
                {Object.entries(conteoGeneros).map(([genero, cantidad]) => (
                    <li>
                        <a href={`/genero/${genero.toLowerCase().replace(' ', '-')}/1`}>
                            {genero} ({cantidad})
                        </a>
                    </li>
                ))}
            </ul>
             <h3>Estado</h3>
                <ul class="estado">
                    {Object.entries(conteoCategoria).map(([cat, cantidad]) => (
                        <li><a href={`/categoria/${cat.toLowerCase().replace(' ', '-')}/1`}>{cat} ({cantidad})</a></li>
                    ))}
                </ul>
        </nav>

        <div class="menu-overlay"></div>
        
        <div class="logo">
            <a href="/">
                <img src="/logo.png" alt="Novelas Ligeras">
            </a>
        </div>

        <nav class="nav-menu">
            <a href="/">Inicio</a>
            <a href="/pais/chinas/1">Chinas</a>
            <a href="/pais/coreanas/1">Coreanas</a>
            <a href="/pais/japonesas/1">Japonesas</a>
            <a href="/categoria/terminadas/1">Terminadas</a>
            <a href="/buscar">Buscar</a>
        </nav>

        <form action="/buscar" method="GET" class="search-box">
           
            <button type="submit">🔍</button>
        </form>
    </header>

    <div class={`main-wrapper ${noSidebar ? 'full-width' : ''}`}>
    {!noSidebar && (
        <aside class="sidebar">
            <h3>Géneros</h3>
            <ul>
                {(() => {
                    const generosOrdenados = Object.entries(conteoGeneros).sort((a, b) => b[1] - a[1]);
                    const top5 = generosOrdenados.slice(0, 5);
                    const resto = generosOrdenados.slice(5);

                    return (
                        <>
                            {top5.map(([genero, cantidad]) => (
                                <li><a href={`/genero/${genero.toLowerCase().replace(' ', '-')}/1`}>{genero} ({cantidad})</a></li>
                            ))}

                            {resto.map(([genero, cantidad]) => (
                                <li class="genero-oculto" style="display: none;">
                                    <a href={`/genero/${genero.toLowerCase().replace(' ', '-')}/1`}>{genero} ({cantidad})</a>
                                </li>
                            ))}

                            {resto.length > 0 && (
                                <li>
                                    <button type="button" id="btn-ver-mas-generos" style="background: none; border: none; color: #2a9d8f; cursor: pointer; padding: 5px 0; font-weight: bold; font-size: 0.95rem;">
                                        Ver más...
                                    </button>
                                </li>
                            )}
                        </>
                    );
                })()}
            </ul>

            <h3>Estado</h3>
            <ul class="estado">
                {Object.entries(conteoCategoria).map(([cat, cantidad]) => (
                    <li><a href={`/categoria/${cat.toLowerCase().replace(' ', '-')}/1`}>{cat} ({cantidad})</a></li>
                ))}
            </ul>
        </aside>
    )}

    <main class="container">
        <slot />
    </main>
</div>

    <footer class="main-footer">
        <div class="footer-content">
            <p>© 2026 Novelas Ligeras - Tu portal de novelas ligeras.</p>
            <p>Diseñado con disciplina y orden.</p>
        </div>
    </footer>

<script>
    const toggle = document.querySelector('.menu-toggle');
    const menu = document.querySelector('.mobile-menu');
    const overlay = document.querySelector('.menu-overlay');
    const closeBtn = document.querySelector('.close-menu');

    function toggleMenu() {
        menu?.classList.toggle('active');
        overlay?.classList.toggle('active');
    }

    toggle?.addEventListener('click', toggleMenu);
    closeBtn?.addEventListener('click', toggleMenu);
    overlay?.addEventListener('click', toggleMenu);

    const btnVerMas = document.getElementById('btn-ver-mas-generos');
    const ocultos = document.querySelectorAll('.genero-oculto');

    if (btnVerMas) {
        btnVerMas.addEventListener('click', () => {
            const estaOculto = ocultos[0] && (ocultos[0] as HTMLElement).style.display === 'none';
            
            ocultos.forEach(el => {
                (el as HTMLElement).style.display = estaOculto ? 'block' : 'none';
            });
            
            btnVerMas.textContent = estaOculto ? 'Ver menos' : 'Ver más...';
        });
    }
</script>

</body>
</html>