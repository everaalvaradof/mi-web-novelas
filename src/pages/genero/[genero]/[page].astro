---
export const prerender = true;
import MainLayout from '../../../layouts/MainLayout.astro';
import { novelas } from '../../../data/novelas.js';
import Ad from '../../../components/Ad.astro';

// 1. Generamos las rutas estáticas de forma totalmente blindada
export function getStaticPaths() {
    const pageSize = 10;
    const generosMap: Record<string, number> = {};

    novelas.forEach(n => {
        if (n.genero) {
            n.genero.split(',').forEach(g => {
                const slugGenero = g ? g.trim().toLowerCase().replace(/\s+/g, '-') : '';
                if (slugGenero) {
                    if (!generosMap[slugGenero]) {
                        generosMap[slugGenero] = 0;
                    }
                    generosMap[slugGenero]++;
                }
            });
        }
    });

    const paths = [];

    for (const [slugGenero, totalNovelas] of Object.entries(generosMap)) {
        if (!slugGenero) continue;
        
        const lastPage = Math.ceil(totalNovelas / pageSize) || 1;
        
        for (let i = 1; i <= lastPage; i++) {
            paths.push({
                params: { 
                    genero: slugGenero, 
                    page: String(i) 
                }
            });
        }
    }

    return paths;
}

// 2. Capturamos el género y el número de página de la URL de forma estática
const { genero, page: pageParam } = Astro.params;

if (!genero) {
    throw new Error("Missing parameter: genero");
}

// Convertimos la página actual a número (si no viene o es inválida, por defecto es la 1)
const currentPage = parseInt(pageParam || '1', 10);
const pageSize = 10;

// 3. Normalizamos el género de la URL para compararlo bien
const formatSlug = (str: string) => str ? str.trim().toLowerCase().replace(/\s+/g, '-') : '';
const generoBusqueda = genero ? genero.trim().toLowerCase() : '';

// 4. Filtramos las novelas que pertenecen a este género
const novelasFiltradas = novelas.filter((n) => {
    if (!n.genero) return false;
    const generosNovela = n.genero.split(',').map(g => formatSlug(g));
    return generosNovela.includes(generoBusqueda);
});

// 5. Calculamos la paginación manual
const totalNovelas = novelasFiltradas.length;
const lastPage = Math.ceil(totalNovelas / pageSize) || 1;
const startIndex = (currentPage - 1) * pageSize;
const paginatedData = novelasFiltradas.slice(startIndex, startIndex + pageSize);

// URLs anterior y siguiente para la paginación
const basePath = `/genero/${genero}`;
const prevUrl = currentPage > 1 ? (currentPage === 2 ? basePath : `${basePath}/${currentPage - 1}`) : null;
const nextUrl = currentPage < lastPage ? `${basePath}/${currentPage + 1}` : null;

const generoLimpio = genero ? genero.charAt(0).toUpperCase() + genero.slice(1).replace(/-/g, ' ') : 'Género';
---

<MainLayout>
    <h1>Género: {generoLimpio}</h1>
    
    <div class="novelas-grid">
        {paginatedData.length > 0 ? (
            paginatedData.map((n) => (
                <a href={`/ver/${n.id}`} class="card-link">
                    <div class="card">
                        <div class="image-container">
                            <img src={n.imagen} alt={n.titulo}>
                            <span class="year">{n.anio}</span>
                        </div>
                        <div class="card-info">
                            <h3>{n.titulo}</h3>
                            <h3>{n.capitulosPublicados}</h3>
                        </div>
                    </div>
                </a>
            ))
        ) : (
            <p>No se encontraron novelas en este género.</p>
        )}
    </div>

    <div class="ad-container" style="margin: 20px 0; text-align: center;">
        <Ad />
    </div>

    <nav class="pagination">
    {prevUrl ? (
        <a href={prevUrl}>
            ⬅️ Anterior
        </a>
    ) : null}
    
    <span>Página {currentPage} de {lastPage}</span>
    
    {nextUrl ? <a href={nextUrl}>Siguiente ➡️</a> : null}
</nav>
</MainLayout>

<style>
    .pagination { display: flex; gap: 1rem; margin-top: 2rem; justify-content: center; align-items: center; }
    .pagination a { padding: 0.5rem 1rem; border: 1px solid #ccc; text-decoration: none; border-radius: 4px; }
</style>