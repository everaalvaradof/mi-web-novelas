---
import { novelas } from '../../data/novelas.js';
import Layout from '../../layouts/MainLayout.astro';

// Función para normalizar igual en ambos lados
const formatSlug = (str) => str.trim().toLowerCase().replace(/\s+/g, '-');

export async function getStaticPaths() {
    const todosLosGeneros = new Set();
    novelas.forEach(n => {
        n.genero.split(',').forEach(g => {
            todosLosGeneros.add(g.trim().toLowerCase().replace(/\s+/g, '-'));
        });
    });

    return Array.from(todosLosGeneros).map(slug => ({
        params: { slug },
    }));
}

const { slug } = Astro.params;

// Filtramos comparando la versión normalizada de cada novela
const novelasFiltradas = novelas.filter(n => 
    n.genero.split(',').some(g => formatSlug(g) === slug)
);

// Hacemos que el nombre del género luzca bien para el SEO (ej: "martial-arts" -> "Martial Arts")
const nombreGeneroLimpio = slug.charAt(0).toUpperCase() + slug.slice(1).replace('-', ' ');
---

<Layout 
    title={`Novelas de ${nombreGeneroLimpio} en Español - Leer Online`}
    description={`Explora nuestra lista completa de novelas del género ${nombreGeneroLimpio}. Lee los mejores capítulos actualizados gratis.`}
>
    <h1>Novelas del género: {nombreGeneroLimpio}</h1>
    
    <div class="novelas-grid">
        {novelasFiltradas.length > 0 ? (
            novelasFiltradas.map(n => (
                <a href={`/novela/${n.id}`} class="card-link">
                    <div class="card">
                        <div class="image-container">
                            <img src={n.imagen} alt={n.titulo}>
                            <span class="year">{n.anio}</span>
                        </div>
                        <div class="card-info">
                            <h3>{n.titulo}</h3>
                        </div>
                    </div>
                </a>
            ))
        ) : (
            <p>No se encontraron novelas en este género.</p>
        )}
    </div>
</Layout>