---
export const prerender = true;
import { novelas } from '../../data/novelas.js';
import Layout from '../../layouts/MainLayout.astro';
import Ad from '../../components/Ad.astro';

// Función para normalizar igual en ambos lados
const formatSlug = (str: string) => str.trim().toLowerCase().replace(/\s+/g, '-');

// 1. Generamos las rutas estáticas para cada género disponible
export function getStaticPaths() {
    const slugsSet = new Set<string>();
    
    novelas.forEach(n => {
        if (n.genero) {
            n.genero.split(',').forEach(g => {
                const slug = g.trim().toLowerCase().replace(/\s+/g, '-');
                if (slug) slugsSet.add(slug);
            });
        }
    });

    return Array.from(slugsSet).map(slug => ({
        params: { slug }
    }));
}

// 2. Capturamos el slug de forma segura
const { slug } = Astro.params;
const generoSlug = typeof slug === 'string' ? slug : '';

// 3. Filtramos comparando la versión normalizada de cada novela
const novelasFiltradas = novelas.filter(n => 
    n.genero && n.genero.split(',').some(g => formatSlug(g) === generoSlug)
);

// Hacemos que el nombre del género luzca bien para el SEO
const nombreGeneroLimpio = generoSlug ? generoSlug.charAt(0).toUpperCase() + generoSlug.slice(1).replace(/-/g, ' ') : 'Género';
---

<Layout 
    title={`Novelas de ${nombreGeneroLimpio} en Español - Leer Online`}
    description={`Explora nuestra lista completa de novelas del género ${nombreGeneroLimpio}. Lee los mejores capítulos actualizados gratis.`}
>
    <h1>Novelas del género: {nombreGeneroLimpio}</h1>
    
    <div class="novelas-grid">
        {novelasFiltradas.length > 0 ? (
            novelasFiltradas.map(n => (
                <a href={`/ver/${n.id}`} class="card-link">
                    <div class="card">
                        <div class="image-container">
                            <img src={n.imagen} alt={n.titulo}>
                            <span class="year">{n.anio}</span>
                        </div>
                        <div class="card-info">
                            <h3>{n.titulo}</h3>
                            <h3>{n.capitulosPublicados}</h3>
                        </div>
                    </div>
                </a>
            ))
        ) : (
            <p>No se encontraron novelas en este género.</p>
        )}
    </div>

    <div class="ad-container" style="margin: 20px 0; text-align: center;">
        <Ad />
    </div>
</Layout>

<style>
    /* Tus estilos se mantienen intactos */
</style>