---
export const prerender = true;
import { novelas } from '../../data/novelas.js';
import Layout from '../../layouts/MainLayout.astro';

// Función para normalizar igual en ambos lados
const formatSlug = (str: string) => str ? str.trim().toLowerCase().replace(/\s+/g, '-') : '';

// 1. Generamos las rutas estáticas para cada país disponible
export function getStaticPaths() {
    const slugsSet = new Set<string>();
    
    novelas.forEach(n => {
        if (n.pais) {
            n.pais.split(',').forEach(p => {
                const slug = formatSlug(p);
                if (slug) slugsSet.add(slug);
            });
        }
    });

    return Array.from(slugsSet).map(slug => ({
        params: { slug }
    }));
}

// 2. Capturamos el slug de forma segura
const { slug } = Astro.params;
const paisSlug = typeof slug === 'string' ? slug : '';

// 3. Filtramos comparando la versión normalizada de cada novela
const novelasFiltradas = novelas.filter(n => {
    if (!n.pais) return false;
    return n.pais.split(',').some(p => formatSlug(p) === paisSlug);
});

// Formateamos el slug para que se vea limpio
const nombrePaisLimpio = paisSlug ? paisSlug.charAt(0).toUpperCase() + paisSlug.slice(1).replace(/-/g, ' ') : 'País';
---

<Layout 
    title={`Novelas de origen ${nombrePaisLimpio} - Leer Online`}
    description={`Descubre las mejores novelas y relatos de origen ${nombrePaisLimpio}. Explora el catálogo completo y léelas totalmente gratis.`}
>
    <h1>Novelas de origen: {nombrePaisLimpio}</h1>
    
    <div class="novelas-grid">
        {novelasFiltradas.length > 0 ? (
            novelasFiltradas.map(n => (
                <a href={`/ver/${n.id}`} class="card-link">
                    <div class="card">
                        <div class="image-container">
                            <img src={n.imagen} alt={n.titulo}>
                            <span class="year">{n.anio}</span>
                        </div>
                        <div class="card-info">
                            <h3>{n.titulo}</h3>
                        </div>
                    </div>
                </a>
            ))
        ) : (
            <p>No se encontraron novelas de este origen.</p>
        )}
    </div>
</Layout>

<style>
    /* Tus estilos se mantienen intactos */
</style>