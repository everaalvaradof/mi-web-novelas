---
import MainLayout from '../../../layouts/MainLayout.astro';
import { novelas } from '../../../data/novelas.js';
import Ad from '../../../components/Ad.astro';

export async function getStaticPaths({ paginate }) {
  const pais = ["chinas", "coreanas", "japonesas", "estrenos"];
  
  return pais.flatMap((cat) => {
    const filteredNovelas = novelas.filter(
      (n) => n.pais.toLowerCase() === cat.toLowerCase()
    );
    
    return paginate(filteredNovelas, {
      params: { pais: cat },
      pageSize: 10,
    });
  });
}

const { page } = Astro.props;
const { pais } = Astro.params;
---

<MainLayout>
  <h1>Categoría: {pais.toUpperCase()}</h1>
  
  <div class="novelas-grid">
    {page.data.map((n) => (
      <a href={`/novela/${n.id}`} class="card-link">
        <div class="card">
          <div class="image-container">
            <img src={n.imagen} alt={n.titulo}>
            <span class="year">{n.anio}</span>
          </div>
          <div class="card-info">
            <h3>{n.titulo}</h3>
            <h3>{n.capitulosPublicados}</h3>
          </div>
        </div>
      </a>
    ))}
  </div>

  <!-- Aquí se inserta el anuncio antes de la paginación -->
  <div class="ad-container" style="margin: 20px 0; text-align: center;">
    <Ad />
  </div>

  <!-- Paginación -->
  <nav class="pagination">
    {page.url.prev ? <a href={page.url.prev}>⬅️ Anterior</a> : null}
    
    <span>Página {page.currentPage} de {page.lastPage}</span>
    
    {page.url.next ? <a href={page.url.next}>Siguiente ➡️</a> : null}
  </nav>
</MainLayout>

<style>
  .pagination { display: flex; gap: 1rem; margin-top: 2rem; justify-content: center; }
  .pagination a { padding: 0.5rem 1rem; border: 1px solid #ccc; text-decoration: none; }
</style>

