---
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import { novelas } from '../../data/novelas.js';
import Ad from '../../components/Ad.astro';

// 1. Capturamos el parámetro dinámico (puede llamarse genero o categoria según tu estructura de carpetas)
const { genero, categoria, page: pageParam } = Astro.params;
const catOrGen = genero || categoria || '';

// Convertimos la página actual a número (si no viene o es inválida, por defecto es la 1)
const currentPage = parseInt(pageParam || '1', 10);
const pageSize = 10;

// 2. Normalizamos para compararlo bien
const busqueda = catOrGen.trim().toLowerCase();

// 3. Filtramos las novelas que pertenecen a esta categoría/género
const novelasFiltradas = novelas.filter((n) => {
    const campo = n.genero || n.categoria || '';
    const elementos = campo.split(',').map(e => e.trim().toLowerCase());
    return elementos.includes(busqueda);
});

// 4. Calculamos la paginación manual
const totalNovelas = novelasFiltradas.length;
const lastPage = Math.ceil(totalNovelas / pageSize) || 1;
const startIndex = (currentPage - 1) * pageSize;
const paginatedData = novelasFiltradas.slice(startIndex, startIndex + pageSize);

// Determinamos dinámicamente si estamos bajo /genero/ o /categoria/
const folderName = genero ? 'genero' : 'categoria';
const basePath = `/${folderName}/${catOrGen}`;

const prevUrl = currentPage > 1 ? (currentPage === 2 ? basePath : `${basePath}/${currentPage - 1}`) : null;
const nextUrl = currentPage < lastPage ? `${basePath}/${currentPage + 1}` : null;

const tituloLimpio = catOrGen ? catOrGen.charAt(0).toUpperCase() + catOrGen.slice(1) : 'Categoría';
---

<MainLayout>
    <h1>Categoría / Género: {tituloLimpio}</h1>
    
    <div class="novelas-grid">
        {paginatedData.length > 0 ? (
            paginatedData.map((n) => (
                <a href={`/novela/${n.id}`} class="card-link">
                    <div class="card">
                        <div class="image-container">
                            <img src={n.imagen} alt={n.titulo}>
                            <span class="year">{n.anio}</span>
                        </div>
                        <div class="card-info">
                            <h3>{n.titulo}</h3>
                            <h3>{n.capitulosPublicados}</h3>
                        </div>
                    </div>
                </a>
            ))
        ) : (
            <p>No se encontraron novelas en esta sección.</p>
        )}
    </div>

    <div class="ad-container" style="margin: 20px 0; text-align: center;">
        <Ad />
    </div>

    <nav class="pagination">
        {prevUrl ? <a href={prevUrl}>⬅️ Anterior</a> : null}
        <span>Página {currentPage} de {lastPage}</span>
        {nextUrl ? <a href={nextUrl}>Siguiente ➡️</a> : null}
    </nav>
</MainLayout>

<style>
    .pagination { display: flex; gap: 1rem; margin-top: 2rem; justify-content: center; align-items: center; }
    .pagination a { padding: 0.5rem 1rem; border: 1px solid #ccc; text-decoration: none; border-radius: 4px; }
</style>