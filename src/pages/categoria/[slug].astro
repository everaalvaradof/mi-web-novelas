---
export const prerender = true;
import MainLayout from '../../layouts/MainLayout.astro';
import { novelas } from '../../data/novelas.js';
import Ad from '../../components/Ad.astro';

// 1. Generamos las rutas estáticas para cada categoría o género disponible
export function getStaticPaths() {
    const slugsSet = new Set<string>();
    
    novelas.forEach(n => {
        const campos = [n.genero, n.categoria];
        campos.forEach(campo => {
            if (campo) {
                campo.split(',').forEach(item => {
                    const slug = item.trim().toLowerCase().replace(/\s+/g, '-');
                    if (slug) slugsSet.add(slug);
                });
            }
        });
    });

    return Array.from(slugsSet).map(slug => ({
        params: { categoria: slug, genero: slug }
    }));
}

// 2. Capturamos el parámetro dinámico de la URL con tipado seguro
const params = Astro.params as { genero?: string; categoria?: string };
const genero = params.genero;
const categoria = params.categoria;
const catOrGen = (genero || categoria || '') as string;

// Como es [slug].astro solito, la página actual siempre es la 1
const currentPage = 1;
const pageSize = 10;

// 3. Normalizamos para compararlo bien
const formatSlug = (str: string) => str ? str.trim().toLowerCase().replace(/\s+/g, '-') : '';
const busqueda = catOrGen.trim().toLowerCase();

// 4. Filtramos las novelas que pertenecen a esta categoría/género
const novelasFiltradas = novelas.filter((n) => {
    const campo = n.genero || n.categoria || '';
    return campo.split(',').some(e => formatSlug(e) === busqueda);
});

// 5. Paginación manual para la primera página
const totalNovelas = novelasFiltradas.length;
const lastPage = Math.ceil(totalNovelas / pageSize) || 1;
const paginatedData = novelasFiltradas.slice(0, pageSize);

// Determinamos dinámicamente si estamos bajo /genero/ o /categoria/
const folderName = genero ? 'genero' : 'categoria';
const basePath = `/${folderName}/${catOrGen}`;

const nextUrl = lastPage > 1 ? `${basePath}/2` : null;
const prevUrl = null; // En la primera página nunca hay anterior

const tituloLimpio = catOrGen ? catOrGen.charAt(0).toUpperCase() + catOrGen.slice(1).replace(/-/g, ' ') : 'Categoría';
---

<MainLayout>
    <h1>Categoría / Género: {tituloLimpio}</h1>
    
    <div class="novelas-grid">
        {paginatedData.length > 0 ? (
            paginatedData.map((n) => (
                <a href={`/ver/${n.id}`} class="card-link">
                    <div class="card">
                        <div class="image-container">
                            <img src={n.imagen} alt={n.titulo}>
                            <span class="year">{n.anio}</span>
                        </div>
                        <div class="card-info">
                            <h3>{n.titulo}</h3>
                            <h3>{n.capitulosPublicados}</h3>
                        </div>
                    </div>
                </a>
            ))
        ) : (
            <p>No se encontraron novelas en esta sección.</p>
        )}
    </div>

    <div class="ad-container" style="margin: 20px 0; text-align: center;">
        <Ad />
    </div>

    <nav class="pagination">
        {prevUrl ? (
            <a href={prevUrl}>
                ⬅️ Anterior
            </a>
        ) : null}
        
        <span>Página {currentPage} de {lastPage}</span>
        
        {nextUrl ? <a href={nextUrl}>Siguiente ➡️</a> : null}
    </nav>
</MainLayout>

<style>
    .pagination { display: flex; gap: 1rem; margin-top: 2rem; justify-content: center; align-items: center; }
    .pagination a { padding: 0.5rem 1rem; border: 1px solid #ccc; text-decoration: none; border-radius: 4px; }
</style>