---
export const prerender = true;
import MainLayout from '../../layouts/MainLayout.astro';
import { novelas } from '../../data/novelas.js';
import Ad from '../../components/Ad.astro';

// 1. Generamos las rutas estáticas usando estrictamente 'slug'
export function getStaticPaths() {
    const slugsSet = new Set<string>();
    
    novelas.forEach(n => {
        if (n.categoria) {
            n.categoria.split(',').forEach(item => {
                const slug = item.trim().toLowerCase().replace(/\s+/g, '-');
                if (slug) slugsSet.add(slug);
            });
        }
    });

    return Array.from(slugsSet).map(slug => ({
        params: { slug }
    }));
}

// 2. Capturamos el parámetro 'slug' que espera Astro
const { slug } = Astro.params as { slug: string };
const currentPage = 1;
const pageSize = 10;

// 3. Normalizamos para la búsqueda
const formatSlug = (str: string) => str ? str.trim().toLowerCase().replace(/\s+/g, '-') : '';
const busqueda = slug ? slug.trim().toLowerCase() : '';

// 4. Filtramos las novelas que pertenecen a esta categoría
const novelasFiltradas = novelas.filter((n) => {
    const campo = n.categoria || '';
    return campo.split(',').some(e => formatSlug(e) === busqueda);
});

// 5. Paginación manual para la primera página
const totalNovelas = novelasFiltradas.length;
const lastPage = Math.ceil(totalNovelas / pageSize) || 1;
const paginatedData = novelasFiltradas.slice(0, pageSize);

const basePath = `/categoria/${slug}`;
const nextUrl = lastPage > 1 ? `${basePath}/2` : null;
const prevUrl = null;

const tituloLimpio = slug ? slug.charAt(0).toUpperCase() + slug.slice(1).replace(/-/g, ' ') : 'Categoría';
---

<MainLayout>
    <h1>Categoría: {tituloLimpio}</h1>
    
    <div class="novelas-grid">
        {paginatedData.length > 0 ? (
            paginatedData.map((n) => (
                <a href={`/ver/${n.id}`} class="card-link">
                    <div class="card">
                        <div class="image-container">
                            <img src={n.imagen} alt={n.titulo}>
                            <span class="year">{n.anio}</span>
                        </div>
                        <div class="card-info">
                            <h3>{n.titulo}</h3>
                            <h3>{n.capitulosPublicados}</h3>
                        </div>
                    </div>
                </a>
            ))
        ) : (
            <p>No se encontraron novelas en esta sección.</p>
        )}
    </div>

    <div class="ad-container" style="margin: 20px 0; text-align: center;">
        <Ad />
    </div>

    <nav class="pagination">
        {prevUrl ? (
            <a href={prevUrl}>
                ⬅️ Anterior
            </a>
        ) : null}
        
        <span>Página {currentPage} de {lastPage}</span>
        
        {nextUrl ? <a href={nextUrl}>Siguiente ➡️</a> : null}
    </nav>
</MainLayout>

<style>
    .pagination { display: flex; gap: 1rem; margin-top: 2rem; justify-content: center; align-items: center; }
    .pagination a { padding: 0.5rem 1rem; border: 1px solid #ccc; text-decoration: none; border-radius: 4px; }
</style>