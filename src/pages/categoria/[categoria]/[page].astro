---
export const prerender = true;
import MainLayout from '../../../layouts/MainLayout.astro';
import { novelas } from '../../../data/novelas.js';
import Ad from '../../../components/Ad.astro';

// 1. Generamos las rutas estáticas para cada categoría y sus respectivas páginas de paginación
export function getStaticPaths() {
    const pageSize = 10;
    const categoriasMap: Record<string, number> = {};

    novelas.forEach(n => {
        if (n.categoria) {
            n.categoria.split(',').forEach(c => {
                const slugCat = c.trim().toLowerCase().replace(/\s+/g, '-');
                if (!categoriasMap[slugCat]) {
                    categoriasMap[slugCat] = 0;
                }
                categoriasMap[slugCat]++;
            });
        }
    });

    const paths = [];

    for (const [slugCat, totalNovelas] of Object.entries(categoriasMap)) {
        const lastPage = Math.ceil(totalNovelas / pageSize) || 1;
        
        for (let i = 1; i <= lastPage; i++) {
            paths.push({
                params: { categoria: slugCat, page: String(i) }
            });
        }
    }

    return paths;
}

// 2. Capturamos la categoría y el número de página de la URL de forma estática
const { categoria, page: pageParam } = Astro.params;

// Convertimos la página actual a número (por defecto la 1 si no viene en la URL)
const currentPage = parseInt(pageParam || '1', 10);
const pageSize = 10;

// 3. Normalizamos la categoría de búsqueda
const formatSlug = (str: string) => str ? str.trim().toLowerCase().replace(/\s+/g, '-') : '';
const catBusqueda = categoria ? categoria.trim().toLowerCase() : '';

// 4. Filtramos las novelas según la categoría
const novelasFiltradas = novelas.filter((n) => {
    if (!n.categoria) return false;
    return n.categoria.split(',').some(c => formatSlug(c) === catBusqueda);
});

// 5. Paginación manual
const totalNovelas = novelasFiltradas.length;
const lastPage = Math.ceil(totalNovelas / pageSize) || 1;
const startIndex = (currentPage - 1) * pageSize;
const paginatedData = novelasFiltradas.slice(startIndex, startIndex + pageSize);

// Construcción de URLs anterior y siguiente
const basePath = `/categoria/${categoria}`;
const prevUrl = currentPage > 1 ? (currentPage === 2 ? basePath : `${basePath}/${currentPage - 1}`) : null;
const nextUrl = currentPage < lastPage ? `${basePath}/${currentPage + 1}` : null;

const categoriaLimpia = categoria ? categoria.toUpperCase() : 'CATEGORÍA';
---

<MainLayout>
    <h1>Categoría: {categoriaLimpia}</h1>
    
    <div class="novelas-grid">
        {paginatedData.length > 0 ? (
            paginatedData.map((n) => (
                <a href={`/ver/${n.id}`} class="card-link">
                    <div class="card">
                        <div class="image-container">
                            <img src={n.imagen} alt={n.titulo}>
                            <span class="year">{n.anio}</span>
                        </div>
                        <div class="card-info">
                            <h3>{n.titulo}</h3>
                            <h3>{n.capitulosPublicados}</h3>
                        </div>
                    </div>
                </a>
            ))
        ) : (
            <p>No se encontraron novelas en esta categoría.</p>
        )}
    </div>

    <!-- Aquí se inserta el anuncio antes de la paginación -->
    <div class="ad-container" style="margin: 20px 0; text-align: center;">
        <Ad />
    </div>

    <!-- Paginación -->
    <nav class="pagination">
    {prevUrl ? (
        <a href={prevUrl === `/categoria/terminadas` ? `/categoria/terminadas/1` : prevUrl}>
            ⬅️ Anterior
        </a>
    ) : null}
    
    <span>Página {currentPage} de {lastPage}</span>
    
    {nextUrl ? <a href={nextUrl}>Siguiente ➡️</a> : null}
</nav>
</MainLayout>

<style>
    .pagination { display: flex; gap: 1rem; margin-top: 2rem; justify-content: center; align-items: center; }
    .pagination a { padding: 0.5rem 1rem; border: 1px solid #ccc; text-decoration: none; border-radius: 4px; }
</style>